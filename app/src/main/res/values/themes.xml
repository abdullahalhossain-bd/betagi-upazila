<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Premium Betagi e-Sheba light theme -->
    <style name="Theme.WebviewPro" parent="Theme.Material3.Light.NoActionBar">
        <item name="colorPrimary">@color/premium_primary</item>
        <item name="colorPrimaryVariant">@color/premium_primary_dark</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSecondary">@color/premium_accent</item>
        <item name="colorSecondaryVariant">@color/premium_accent</item>
        <item name="colorOnSecondary">@color/black</item>
        <item name="android:windowBackground">@color/premium_background</item>
        <item name="android:navigationBarColor">@color/premium_surface</item>
        <item name="android:statusBarColor">@color/premium_primary_dark</item>
        <item name="android:windowLightStatusBar" tools:ignore="NewApi">false</item>
        <item name="android:fontFamily">sans</item>
    </style>

    <style name="AlertDialogTheme" parent="Theme.AppCompat.Light.Dialog.Alert">
        <item name="android:windowAnimationStyle">@android:style/Animation.Dialog</item>
    </style>

    <style name="Base.Theme.WebviewPro" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/premium_primary</item>
        <item name="colorSecondary">@color/premium_accent</item>
        <item name="android:windowBackground">@color/premium_background</item>
    </style>
</resources>
