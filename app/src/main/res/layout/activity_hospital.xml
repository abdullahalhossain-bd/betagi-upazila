<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/premium_background"
    android:orientation="vertical">

    <RelativeLayout
        android:id="@+id/title"
        android:layout_width="match_parent"
        android:layout_height="68dp"
        android:background="@color/premium_primary"
        android:elevation="4dp"
        android:paddingStart="10dp"
        android:paddingEnd="16dp">
        <ImageView
            android:id="@+id/back_button"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:background="@drawable/premium_primary_button"
            android:contentDescription="পেছনে"
            android:padding="12dp"
            android:rotation="180"
            android:src="@drawable/baseline_double_arrow_24"
            android:tint="@android:color/white" />
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:orientation="vertical">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/bnlatxf"
                android:text="স্বাস্থ্যসেবা"
                android:textColor="@android:color/white"
                android:textSize="20sp"
                android:textStyle="bold" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:fontFamily="@font/bnlatxf"
                android:text="হাসপাতাল ও ভেটেরিনারি সেবা"
                android:textColor="#DCEBFF"
                android:textSize="11sp" />
        </LinearLayout>
    </RelativeLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:fillViewport="true">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/bnlatxf"
                android:text="স্বাস্থ্যসেবা কেন্দ্র"
                android:textColor="@color/premium_text"
                android:textSize="19sp"
                android:textStyle="bold" />

            <androidx.cardview.widget.CardView
                android:id="@+id/card1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                app:cardBackgroundColor="@color/premium_surface"
                app:cardCornerRadius="22dp"
                app:cardElevation="3dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">
                    <ImageView
                        android:id="@+id/hospital_image"
                        android:layout_width="match_parent"
                        android:layout_height="180dp"
                        android:contentDescription="হাসপাতালের ছবি"
                        android:scaleType="centerCrop"
                        android:src="@drawable/health" />
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="17dp">
                        <TextView
                            android:id="@+id/hospital_name"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/bnlatxf"
                            android:text="বেতাগী উপজেলা স্বাস্থ্য কমপ্লেক্স"
                            android:textColor="@color/premium_text"
                            android:textSize="17sp"
                            android:textStyle="bold" />
                        <TextView
                            android:id="@+id/hospital_speciality"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:fontFamily="@font/bnlatxf"
                            android:text="জেনারেল হাসপাতাল"
                            android:textColor="@color/premium_text_secondary"
                            android:textSize="13sp" />
                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:layout_marginTop="13dp"
                            android:layout_marginBottom="12dp"
                            android:background="@color/premium_border" />
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">
                            <ImageView
                                android:layout_width="20dp"
                                android:layout_height="20dp"
                                android:contentDescription="ঠিকানা"
                                android:src="@drawable/ic_location"
                                android:tint="@color/premium_primary" />
                            <TextView
                                android:id="@+id/hospital_address"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="9dp"
                                android:layout_weight="1"
                                android:fontFamily="@font/bnlatxf"
                                android:text="লঞ্চঘাট রোড, বেতাগী"
                                android:textColor="@color/premium_text_secondary"
                                android:textSize="14sp" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <androidx.cardview.widget.CardView
                android:id="@+id/card2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                app:cardBackgroundColor="@color/premium_surface"
                app:cardCornerRadius="22dp"
                app:cardElevation="3dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">
                    <ImageView
                        android:id="@+id/anihospital_image"
                        android:layout_width="match_parent"
                        android:layout_height="180dp"
                        android:contentDescription="প্রাণিসম্পদ হাসপাতালের ছবি"
                        android:scaleType="centerCrop"
                        android:src="@drawable/animal" />
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="17dp">
                        <TextView
                            android:id="@+id/anihospital_name"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/bnlatxf"
                            android:text="উপজেলা প্রাণিসম্পদ সেবা ও ভেটেরিনারি হাসপাতাল"
                            android:textColor="@color/premium_text"
                            android:textSize="17sp"
                            android:textStyle="bold" />
                        <TextView
                            android:id="@+id/anihospital_speciality"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:fontFamily="@font/bnlatxf"
                            android:text="পশু হাসপাতাল"
                            android:textColor="@color/premium_text_secondary"
                            android:textSize="13sp" />
                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:layout_marginTop="13dp"
                            android:layout_marginBottom="12dp"
                            android:background="@color/premium_border" />
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">
                            <ImageView
                                android:layout_width="20dp"
                                android:layout_height="20dp"
                                android:contentDescription="ঠিকানা"
                                android:src="@drawable/ic_location"
                                android:tint="@color/premium_primary" />
                            <TextView
                                android:id="@+id/anihospital_address"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="9dp"
                                android:layout_weight="1"
                                android:fontFamily="@font/bnlatxf"
                                android:text="হাইস্কুলের সামনে T&amp;T রোড, বেতাগী"
                                android:textColor="@color/premium_text_secondary"
                                android:textSize="14sp" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
            </androidx.cardview.widget.CardView>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
