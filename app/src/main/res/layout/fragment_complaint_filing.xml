<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    android:clipToPadding="false"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/premium_background"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="30dp">

            <ImageView
                android:id="@+id/topBackgroundImage"
                android:layout_width="0dp"
                android:layout_height="300dp"
                android:src="@drawable/registation"
                android:scaleType="centerCrop"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <TextView
                android:id="@+id/welcomeText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="60dp"
                android:text="আপনার অভিযোগ \nদাখিল করুন ।"
                android:textSize="20sp"
                android:textStyle="bold"
                android:fontFamily="@font/bnlatx"
                android:textColor="#ffffff"
                android:gravity="center"
                app:layout_constraintBottom_toBottomOf="@id/topBackgroundImage"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <androidx.cardview.widget.CardView
                android:id="@+id/complaintCard"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                android:layout_marginTop="-40dp"
                app:cardBackgroundColor="@color/premium_surface"
                app:cardCornerRadius="20dp"
                app:cardElevation="3dp"
                app:layout_constraintTop_toBottomOf="@id/topBackgroundImage"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/complaintTypeLayout"
                        style="@style/Widget.MaterialComponents.TextInputLayout.ExposedDropdownMenu"
                        android:layout_width="match_parent"
                        android:layout_height="80dp"
                        android:hint="অভিযোগের ধরণ নির্বাচন করুন"
                        android:layout_margin="5dp">
                        <AutoCompleteTextView
                            android:id="@+id/complaintTypeAutoComplete"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:background="@drawable/autocomplete_background"
                            android:fontFamily="@font/bnlatxf"
                            android:inputType="none" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/complaintTitleLayout"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="অভিযোগের শিরোনাম"
                        android:layout_margin="5dp">
                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/complaintTitle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/bnlatxf" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/complaintDetailsLayout"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="বিস্তারিত লিখুন"
                        android:layout_margin="5dp">
                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/complaintDetailsEditText"
                            android:layout_width="match_parent"
                            android:layout_height="120dp"
                            android:gravity="top"
                            android:fontFamily="@font/bnlatxf" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/locationLayout"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="অবস্থান"
                        android:layout_margin="5dp">
                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/locationEditText"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/bnlatxf" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/departmentLayout"
                        style="@style/Widget.MaterialComponents.TextInputLayout.ExposedDropdownMenu"
                        android:layout_width="match_parent"
                        android:layout_height="80dp"
                        android:hint="বিভাগ নির্বাচন করুন"
                        android:layout_margin="5dp">
                        <AutoCompleteTextView
                            android:id="@+id/departmentAutoComplete"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:background="@drawable/autocomplete_background"
                            android:fontFamily="@font/bnlatxf"
                            android:inputType="none" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/priorityLayout"
                        style="@style/Widget.MaterialComponents.TextInputLayout.ExposedDropdownMenu"
                        android:layout_width="match_parent"
                        android:layout_height="80dp"
                        android:hint="অগ্রাধিকার নির্বাচন করুন"
                        android:layout_margin="5dp">
                        <AutoCompleteTextView
                            android:id="@+id/priorityAutoComplete"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:background="@drawable/autocomplete_background"
                            android:fontFamily="@font/bnlatxf"
                            android:inputType="none" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/contactNumberLayout"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="যোগাযোগ নম্বর"
                        android:layout_margin="5dp">
                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/contactNumberEditText"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/bnlatxf"
                            android:inputType="phone" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/emailLayout"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="ইমেইল ঠিকানা"
                        android:layout_margin="5dp">
                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/emailEditText"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/bnlatxf"
                            android:inputType="textEmailAddress" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/complainantNameLayout"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="অভিযোগকারীর নাম"
                        android:layout_margin="5dp">
                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/complainantNameEditText"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/bnlatxf" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/complaintDateLayout"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="অভিযোগের তারিখ"
                        android:layout_margin="5dp">
                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/complaintDateEditText"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/bnlatxf"
                            android:inputType="date"
                            android:focusable="false" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <androidx.cardview.widget.CardView
                        android:id="@+id/attachPhotoButton"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:layout_marginBottom="10dp"
                        app:cardBackgroundColor="@color/premium_primary"
                        app:cardCornerRadius="20dp"
                        app:cardElevation="2dp">
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:padding="16dp"
                            android:text="ছবি সংযুক্ত করুন"
                            android:textColor="@android:color/white"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            android:gravity="center"
                            android:fontFamily="@font/bnlatxf" />
                    </androidx.cardview.widget.CardView>

                    <ImageView
                        android:id="@+id/attachedPhotoPreview"
                        android:layout_width="match_parent"
                        android:layout_height="150dp"
                        android:scaleType="centerCrop"
                        android:visibility="gone"
                        android:layout_margin="5dp"
                        android:contentDescription="Attached photo preview" />

                    <androidx.cardview.widget.CardView
                        android:id="@+id/submitButton"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:layout_marginBottom="10dp"
                        app:cardBackgroundColor="@color/premium_primary"
                        app:cardCornerRadius="20dp"
                        app:cardElevation="2dp">
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:padding="16dp"
                            android:text="দাখিল করুন"
                            android:textColor="@android:color/white"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            android:gravity="center"
                            android:fontFamily="@font/bnlatxf" />
                    </androidx.cardview.widget.CardView>

                    <androidx.cardview.widget.CardView
                        android:id="@+id/clearButton"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="5dp"
                        android:layout_marginBottom="10dp"
                        app:cardBackgroundColor="@color/premium_border"
                        app:cardCornerRadius="20dp"
                        app:cardElevation="0dp">
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:padding="16dp"
                            android:text="পরিষ্কার করুন"
                            android:textColor="@color/premium_text"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            android:gravity="center"
                            android:fontFamily="@font/bnlatxf" />
                    </androidx.cardview.widget.CardView>

                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <ProgressBar
                android:id="@+id/progress"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:visibility="gone"
                app:layout_constraintTop_toBottomOf="@id/complaintCard" />

        </androidx.constraintlayout.widget.ConstraintLayout>
    </LinearLayout>
</ScrollView>
