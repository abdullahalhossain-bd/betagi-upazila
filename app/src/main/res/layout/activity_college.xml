<?xml version="1.0" encoding="utf-8"?
    android:background="@color/premium_background">
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/premium_background"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/title"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:background="@color/premium_primary"
        android:elevation="3dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="8dp"
        android:paddingEnd="20dp">

        <ImageButton
            android:id="@+id/back_button"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@drawable/premium_primary_button"
            android:contentDescription="পেছনে যান"
            android:padding="12dp"
            android:rotation="180"
            android:src="@drawable/baseline_double_arrow_24"
            app:tint="@android:color/white" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:fontFamily="@font/bnlatxf"
            android:text="সকল কলেজের তালিকা"
            android:textColor="@android:color/white"
            android:textSize="20sp"
            android:textStyle="bold" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:paddingStart="16dp"
        android:paddingTop="16dp"
        android:paddingEnd="16dp"
        android:paddingBottom="24dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:backgroundTint="@color/premium_surface"
                app:cardCornerRadius="18dp"
                app:cardElevation="2dp"
                app:strokeColor="@color/premium_border"
                app:strokeWidth="1dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:padding="14dp">
                    <ImageView android:layout_width="52dp" android:layout_height="52dp" android:contentDescription="কলেজ" android:src="@drawable/college" />
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="14dp" android:layout_weight="1" android:fontFamily="@font/bnlatxf" android:text="বেতাগী সরকারি কলেজ" android:textColor="@color/premium_text" android:textSize="16sp" android:textStyle="bold" />
                    <ImageView android:layout_width="24dp" android:layout_height="24dp" android:src="@drawable/college" android:alpha="0.55" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="12dp"
                android:backgroundTint="@color/premium_surface" app:cardCornerRadius="18dp" app:cardElevation="2dp" app:strokeColor="@color/premium_border" app:strokeWidth="1dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:padding="14dp">
                    <ImageView android:layout_width="52dp" android:layout_height="52dp" android:contentDescription="কলেজ" android:src="@drawable/college" />
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="14dp" android:layout_weight="1" android:fontFamily="@font/bnlatxf" android:text="চান্দখালী মোশাররফ হোসেন কলেজ" android:textColor="@color/premium_text" android:textSize="16sp" android:textStyle="bold" />
                    <ImageView android:layout_width="24dp" android:layout_height="24dp" android:src="@drawable/college" android:alpha="0.55" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="12dp"
                android:backgroundTint="@color/premium_surface" app:cardCornerRadius="18dp" app:cardElevation="2dp" app:strokeColor="@color/premium_border" app:strokeWidth="1dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:padding="14dp">
                    <ImageView android:layout_width="52dp" android:layout_height="52dp" android:contentDescription="কলেজ" android:src="@drawable/college" />
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="14dp" android:layout_weight="1" android:fontFamily="@font/bnlatxf" android:text="কাউনিয়া কলেজ" android:textColor="@color/premium_text" android:textSize="16sp" android:textStyle="bold" />
                    <ImageView android:layout_width="24dp" android:layout_height="24dp" android:src="@drawable/college" android:alpha="0.55" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="12dp"
                android:backgroundTint="@color/premium_surface" app:cardCornerRadius="18dp" app:cardElevation="2dp" app:strokeColor="@color/premium_border" app:strokeWidth="1dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:padding="14dp">
                    <ImageView android:layout_width="52dp" android:layout_height="52dp" android:contentDescription="কলেজ" android:src="@drawable/college" />
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="14dp" android:layout_weight="1" android:fontFamily="@font/bnlatxf" android:text="ডাঃ আছমত আলী কলেজ" android:textColor="@color/premium_text" android:textSize="16sp" android:textStyle="bold" />
                    <ImageView android:layout_width="24dp" android:layout_height="24dp" android:src="@drawable/college" android:alpha="0.55" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="12dp"
                android:backgroundTint="@color/premium_surface" app:cardCornerRadius="18dp" app:cardElevation="2dp" app:strokeColor="@color/premium_border" app:strokeWidth="1dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:padding="14dp">
                    <ImageView android:layout_width="52dp" android:layout_height="52dp" android:contentDescription="কলেজ" android:src="@drawable/college" />
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="14dp" android:layout_weight="1" android:fontFamily="@font/bnlatxf" android:text="আক্তার মোর্শেদ কৃষি কলেজ" android:textColor="@color/premium_text" android:textSize="16sp" android:textStyle="bold" />
                    <ImageView android:layout_width="24dp" android:layout_height="24dp" android:src="@drawable/college" android:alpha="0.55" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="12dp"
                android:backgroundTint="@color/premium_surface" app:cardCornerRadius="18dp" app:cardElevation="2dp" app:strokeColor="@color/premium_border" app:strokeWidth="1dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:padding="14dp">
                    <ImageView android:layout_width="52dp" android:layout_height="52dp" android:contentDescription="কলেজ" android:src="@drawable/college" />
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="14dp" android:layout_weight="1" android:fontFamily="@font/bnlatxf" android:text="বিবিচিনি নিয়ামতি যুক্ত মাঃ বিঃ ও কলেজ" android:textColor="@color/premium_text" android:textSize="16sp" android:textStyle="bold" />
                    <ImageView android:layout_width="24dp" android:layout_height="24dp" android:src="@drawable/college" android:alpha="0.55" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="12dp"
                android:backgroundTint="@color/premium_surface" app:cardCornerRadius="18dp" app:cardElevation="2dp" app:strokeColor="@color/premium_border" app:strokeWidth="1dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:padding="14dp">
                    <ImageView android:layout_width="52dp" android:layout_height="52dp" android:contentDescription="কলেজ" android:src="@drawable/college" />
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="14dp" android:layout_weight="1" android:fontFamily="@font/bnlatxf" android:text="বেতাগী গার্লস স্কুল এন্ড কলেজ" android:textColor="@color/premium_text" android:textSize="16sp" android:textStyle="bold" />
                    <ImageView android:layout_width="24dp" android:layout_height="24dp" android:src="@drawable/college" android:alpha="0.55" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="12dp"
                android:backgroundTint="@color/premium_surface" app:cardCornerRadius="18dp" app:cardElevation="2dp" app:strokeColor="@color/premium_border" app:strokeWidth="1dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:padding="14dp">
                    <ImageView android:layout_width="52dp" android:layout_height="52dp" android:contentDescription="কলেজ" android:src="@drawable/college" />
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="14dp" android:layout_weight="1" android:fontFamily="@font/bnlatxf" android:text="বেতাগী টেকনিক্যাল বি এম কলেজ" android:textColor="@color/premium_text" android:textSize="16sp" android:textStyle="bold" />
                    <ImageView android:layout_width="24dp" android:layout_height="24dp" android:src="@drawable/college" android:alpha="0.55" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="12dp"
                android:backgroundTint="@color/premium_surface" app:cardCornerRadius="18dp" app:cardElevation="2dp" app:strokeColor="@color/premium_border" app:strokeWidth="1dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:padding="14dp">
                    <ImageView android:layout_width="52dp" android:layout_height="52dp" android:contentDescription="কলেজ" android:src="@drawable/college" />
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="14dp" android:layout_weight="1" android:fontFamily="@font/bnlatxf" android:text="ওহিদুর রহমান শাহিন মহিলা কলেজ" android:textColor="@color/premium_text" android:textSize="16sp" android:textStyle="bold" />
                    <ImageView android:layout_width="24dp" android:layout_height="24dp" android:src="@drawable/college" android:alpha="0.55" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>
    </ScrollView>
</LinearLayout>