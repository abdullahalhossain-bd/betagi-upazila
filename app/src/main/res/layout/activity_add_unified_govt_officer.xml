<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" xmlns:tools="http://schemas.android.com/tools" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/premium_background" android:fillViewport="true">
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingBottom="24dp">
<FrameLayout android:layout_width="match_parent" android:layout_height="220dp"><ImageView android:id="@+id/topBackgroundImage" android:layout_width="match_parent" android:layout_height="match_parent" android:src="@drawable/registation" android:scaleType="centerCrop"/><TextView android:id="@+id/welcomeText" android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center" android:padding="24dp" android:text="সরকারি অফিসার\nযোগ করুন" android:textColor="@android:color/white" android:textSize="22sp" android:textStyle="bold" android:fontFamily="@font/bnlatxf"/></FrameLayout>
<androidx.cardview.widget.CardView android:id="@+id/registrationCard" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_margin="16dp" android:layout_marginTop="-28dp" app:cardBackgroundColor="@color/premium_surface" app:cardCornerRadius="22dp" app:cardElevation="3dp"><LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="18dp">
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal"><ImageView android:id="@+id/govtOfficerImage" android:layout_width="76dp" android:layout_height="76dp" android:layout_marginEnd="14dp" android:src="@drawable/baseline_library_add_24" app:tint="@color/premium_primary"/><com.google.android.material.textfield.TextInputLayout android:id="@+id/nameInputLayout" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:hint="অফিসারের নাম দিন"><com.google.android.material.textfield.TextInputEditText android:id="@+id/nameInput" android:layout_width="match_parent" android:layout_height="wrap_content" android:fontFamily="@font/bnlatxf" android:inputType="text"/></com.google.android.material.textfield.TextInputLayout></LinearLayout>
<com.google.android.material.textfield.TextInputLayout android:id="@+id/rankInputLayout" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:hint="পদবী দিন"><com.google.android.material.textfield.TextInputEditText android:id="@+id/rankInput" android:layout_width="match_parent" android:layout_height="wrap_content" android:fontFamily="@font/bnlatxf" android:inputType="text"/></com.google.android.material.textfield.TextInputLayout>
<com.google.android.material.textfield.TextInputLayout android:id="@+id/phoneInputLayout" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:hint="মোবাইল নম্বর দিন"><com.google.android.material.textfield.TextInputEditText android:id="@+id/phoneInput" android:layout_width="match_parent" android:layout_height="wrap_content" android:fontFamily="@font/bnlatxf" android:inputType="phone"/></com.google.android.material.textfield.TextInputLayout>
<androidx.cardview.widget.CardView android:id="@+id/submitButton" android:layout_width="match_parent" android:layout_height="52dp" android:layout_marginTop="18dp" app:cardBackgroundColor="@color/premium_primary" app:cardCornerRadius="16dp"><TextView android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center" android:text="সাবমিট করুন" android:textColor="@android:color/white" android:textSize="16sp" android:textStyle="bold" android:fontFamily="@font/bnlatxf"/></androidx.cardview.widget.CardView>
</LinearLayout></androidx.cardview.widget.CardView><ProgressBar android:id="@+id/progress" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="center" android:visibility="gone" tools:ignore="MissingConstraints"/></LinearLayout></ScrollView>