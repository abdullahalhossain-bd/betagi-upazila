<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground"
    app:cardBackgroundColor="@color/premium_surface"
    app:cardCornerRadius="20dp"
    app:cardElevation="2dp"
    app:strokeColor="@color/premium_border"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_marginBottom="10dp">

            <TextView
                android:id="@+id/noticeTypeText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/notice_type_background"
                android:fontFamily="@font/bnlatxf"
                android:paddingStart="9dp"
                android:paddingTop="4dp"
                android:paddingEnd="9dp"
                android:paddingBottom="4dp"
                android:text="গুরুত্বপূর্ণ"
                android:textColor="@android:color/white"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/noticeDateText"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:fontFamily="@font/bnlatxf"
                android:gravity="end"
                android:maxLines="1"
                android:text="২৫ জানুয়ারি, ২০২৫"
                android:textColor="@color/premium_text_secondary"
                android:textSize="11sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/noticeTitleText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="@font/bnlatxf"
            android:maxLines="2"
            android:text="নোটিশের শিরোনাম"
            android:textColor="@color/premium_text"
            android:textSize="17sp"
            android:textStyle="bold"
            android:layout_marginBottom="7dp" />

        <TextView
            android:id="@+id/noticeDescriptionText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="@font/bnlatxf"
            android:lineSpacingExtra="2dp"
            android:maxLines="3"
            android:text="নোটিশের বিস্তারিত বিবরণ..."
            android:textColor="@color/premium_text_secondary"
            android:textSize="13sp"
            android:layout_marginBottom="12dp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/premium_border"
            android:alpha="0.65"
            android:layout_marginBottom="10dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/noticeDepartmentText"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:fontFamily="@font/bnlatxf"
                android:maxLines="1"
                android:text="উপজেলা প্রশাসন"
                android:textColor="@color/premium_text_secondary"
                android:textSize="11sp" />

            <ImageView
                android:id="@+id/noticeImageIndicator"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_marginEnd="8dp"
                android:contentDescription="Has image"
                android:src="@android:drawable/ic_menu_gallery"
                android:tint="@color/premium_primary"
                android:visibility="gone" />

            <TextView
                android:id="@+id/noticeAttachmentText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:drawableStart="@drawable/ic_attachment"
                android:drawablePadding="4dp"
                android:fontFamily="@font/bnlatxf"
                android:gravity="center_vertical"
                android:text="সংযুক্তি: ১"
                android:textColor="@color/premium_primary"
                android:textSize="11sp"
                android:layout_marginEnd="4dp" />

            <ImageButton
                android:id="@+id/noticeEditButton"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Edit notice"
                android:padding="8dp"
                android:scaleType="centerInside"
                android:src="@android:drawable/ic_menu_edit"
                android:tint="@color/premium_primary"
                android:visibility="gone" />

            <ImageButton
                android:id="@+id/noticeDeleteButton"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Delete notice"
                android:padding="8dp"
                android:scaleType="centerInside"
                android:src="@android:drawable/ic_menu_delete"
                android:tint="@color/premium_primary"
                android:visibility="gone" />
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
