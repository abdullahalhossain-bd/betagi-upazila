<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingTop="6dp" android:paddingBottom="6dp">
<androidx.cardview.widget.CardView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="4dp" app:cardBackgroundColor="@color/premium_surface" app:cardCornerRadius="20dp" app:cardElevation="3dp">
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal" android:padding="14dp">
<de.hdodenhof.circleimageview.CircleImageView android:id="@+id/police" android:layout_width="72dp" android:layout_height="72dp" android:layout_marginEnd="14dp" android:contentDescription="Thana Logo" android:src="@drawable/poli" android:padding="3dp" android:background="@drawable/premium_card_background"/>
<LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
<TextView android:id="@+id/officer_name" android:layout_width="match_parent" android:layout_height="wrap_content" android:fontFamily="@font/bnlatxf" android:text="থানার নাম" android:textColor="@color/premium_text" android:textSize="16sp" android:textStyle="bold"/>
<TextView android:id="@+id/officer_rank" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:fontFamily="@font/bnlatxf" android:text="ঠিকানা" android:textColor="@color/premium_text_secondary" android:textSize="13sp"/>
<TextView android:id="@+id/officer_phone" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:fontFamily="@font/bnlatxf" android:text="ফোন নম্বর" android:textColor="@color/premium_primary" android:textSize="14sp" android:textStyle="bold"/>
</LinearLayout>
<LinearLayout android:layout_width="64dp" android:layout_height="wrap_content" android:gravity="center" android:orientation="vertical"><com.airbnb.lottie.LottieAnimationView android:id="@+id/lottie_call" android:layout_width="52dp" android:layout_height="52dp" android:contentDescription="Call Animation" app:lottie_autoPlay="true" app:lottie_loop="true" app:lottie_rawRes="@raw/call"/><TextView android:id="@+id/text_call" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:fontFamily="@font/bnlatxf" android:text="কল করুন" android:textColor="@color/premium_text" android:textSize="12sp" android:textStyle="bold"/></LinearLayout>
</LinearLayout></androidx.cardview.widget.CardView></LinearLayout>